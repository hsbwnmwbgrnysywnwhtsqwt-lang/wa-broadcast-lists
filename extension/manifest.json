{
  "manifest_version": 3,
  "name": "WA רשימות תפוצה",
  "version": "1.2.2",
  "description": "רשימות תפוצה ל-WhatsApp Web – לאנשי קשר ולקבוצות, עם טקסט, תמונות וסרטונים. מסמן את הנמענים, והשליחה ידנית.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "רשימות תפוצה",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
